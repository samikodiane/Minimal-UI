{
  "name": "@samikodiane/minimal-ui",
  "version": "0.1.0",
  "description": "Shared Expo UI components for apps",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
    "build": "node internal/module_scripts/build.js",
    "clean": "node internal/module_scripts/clean.js",
    "lint": "eslint src/",
    "test": "node internal/module_scripts/test.js",
    "prepare": "node internal/module_scripts/prepare.js",
    "start": "npm run start --prefix example",
    "android": "npm run android --prefix example",
    "ios": "npm run ios --prefix example",
    "web": "npm run web --prefix example",
    "open:ios": "node internal/module_scripts/open-ios.js",
    "open:android": "node internal/module_scripts/open-android.js"
  },
  "keywords": [
    "react-native",
    "expo",
    "minimal-ui",
    "MinimalUI"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/samikodiane/Minimal-UI.git"
  },
  "bugs": {
    "url": "https://github.com/samikodiane/Minimal-UI/issues"
  },
  "author": "Samik",
  "license": "MIT",
  "homepage": "https://github.com/samikodiane/Minimal-UI#readme",
  "dependencies": {
    "@expo-google-fonts/abel": "^0.4.0",
    "@expo-google-fonts/acme": "^0.4.2",
    "@expo-google-fonts/amatic-sc": "^0.4.2",
    "@expo-google-fonts/audiowide": "^0.4.1",
    "@expo-google-fonts/bangers": "^0.4.1",
    "@expo-google-fonts/bebas-neue": "^0.4.1",
    "@expo-google-fonts/bungee": "^0.4.1",
    "@expo-google-fonts/caveat": "^0.4.2",
    "@expo-google-fonts/changa": "^0.4.2",
    "@expo-google-fonts/cinzel": "^0.4.2",
    "@expo-google-fonts/courgette": "^0.4.1",
    "@expo-google-fonts/goldman": "^0.4.2",
    "@expo-google-fonts/gruppo": "^0.4.2",
    "@expo-google-fonts/iceland": "^0.4.1",
    "@expo-google-fonts/instrument-serif": "^0.4.1",
    "@expo-google-fonts/josefin-sans": "^0.4.2",
    "@expo-google-fonts/kalam": "^0.4.1",
    "@expo-google-fonts/lexend-exa": "^0.4.2",
    "@expo-google-fonts/lora": "^0.4.2",
